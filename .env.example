# Auth.js authentication. Values are server-only. Google credentials are optional for password login.
# AUTH_SECRET and DATABASE_URL are required for all sign-in methods.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# PostgreSQL URL for the restricted prepyard_web login, never postgres/service_role.
# Use certificate-verified TLS for hosted databases; do not disable verification.
DATABASE_URL=
# Trusted importer configuration only, if needed.
GITHUB_TOKEN=

# Verification/reset email delivery. Use a verified Resend sender domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
