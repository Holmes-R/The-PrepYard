# Local development can keep Gmail. Render's Blueprint uses Gmail API instead.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-generated-local-secret
DATABASE_URL=postgresql://prepyard_web.PROJECT_REF:URL_ENCODED_ROLE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
AUTH_EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# For Resend, set AUTH_EMAIL_PROVIDER=resend and fill these values privately.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# For Render Free, select AUTH_EMAIL_PROVIDER=gmail-api; see docs/gmail-api-email.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
