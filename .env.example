# Google sign-in managed by Auth.js. Values are server-only.
# Missing configuration disables sign-in and denies protected routes.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# PostgreSQL URL for the restricted prepyard_web login, never postgres/service_role.
# Use certificate-verified TLS for hosted databases; do not disable verification.
DATABASE_URL=
# Trusted importer configuration only, if needed.
GITHUB_TOKEN=
